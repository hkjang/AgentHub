# syntax=docker/dockerfile:1.7
#
# The Qwen Code runtime image.
#
# Separate from agenthub-base for the same reasons Langflow is: it carries its
# own Node toolchain and its own agent, it moves on the vendor's schedule, and a
# site that does not run Qwen Code agents should not have to load it. It is also
# deliberately lean — a coding agent needs git, grep and a language runtime, not
# the whole data-science toolchain the shared image carries.
#
# Two programs matter here. `qwen` is the agent, a terminal UI with its own tool
# loop; `ttyd` is what puts that terminal in a browser, because a TUI with no
# surface cannot be a workspace somebody opens. Both run as the unprivileged
# runtime user, and ttyd binds to loopback: the token-checking proxy sidecar is
# the only way in.
#
# A coding agent that cannot install a package is half an agent, so this image
# carries the same arrangement the shared one does: a virtualenv owned by the
# runtime user, first on PATH, so `pip install` works in a session without root
# and without fighting Debian's externally-managed marker. `npm install -g`
# works for the same reason — the global prefix is under the agent's home.
ARG NODE_IMAGE=22-bookworm-slim
FROM node:${NODE_IMAGE}

ARG QWEN_CODE_VERSION=0.21.14
# Pinned with its checksum: this is a binary downloaded at build time, and an
# unpinned one would make the image unreproducible in exactly the way an offline
# release must not be.
ARG TTYD_VERSION=1.7.7
ARG TTYD_SHA256_X86_64=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55
ARG TTYD_SHA256_AARCH64=

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git ca-certificates curl openssh-client tini jq ripgrep less procps \
      python3 python3-venv \
 && npm install --global "@qwen-code/qwen-code@${QWEN_CODE_VERSION}" \
 && npm cache clean --force \
 && arch="$(uname -m)"; \
    case "${arch}" in \
      x86_64) asset="ttyd.x86_64"; sum="${TTYD_SHA256_X86_64}" ;; \
      aarch64) asset="ttyd.aarch64"; sum="${TTYD_SHA256_AARCH64}" ;; \
      *) echo "unsupported architecture ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/ttyd "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/${asset}"; \
    if [ -n "${sum}" ]; then echo "${sum}  /usr/local/bin/ttyd" | sha256sum -c -; \
    else echo "no checksum pinned for ${arch}; refusing to ship an unverified binary" >&2; exit 1; fi \
 && chmod 0755 /usr/local/bin/ttyd \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /workspace /home/agent/.qwen \
 && chown -R 10000:10000 /workspace /home/agent

# The toolchain an agent writing Python reaches for before it can run anything.
# Deliberately shorter than the shared image's list: what is missing is one
# `pip install` away, and every megabyte here is a megabyte every site that runs
# a Qwen Code agent has to carry through its media path.
ARG AGENT_TOOLCHAIN="pip setuptools wheel ruff black mypy pytest pytest-asyncio ipython rich typer httpx requests pyyaml python-dotenv jinja2 tqdm pydantic tabulate openai mcp"
RUN python3 -m venv /opt/agenthub/venv \
 && /opt/agenthub/venv/bin/pip install --no-cache-dir --upgrade ${AGENT_TOOLCHAIN} \
 && mkdir -p /home/agent/.npm-global /home/agent/.cache \
 && chown -R 10000:10000 /opt/agenthub /home/agent

COPY deploy/runtime/agenthub-report-config.sh /usr/local/bin/agenthub-report-config
COPY deploy/runtime/qwencode-configure.sh /usr/local/bin/agenthub-qwencode-configure
COPY deploy/runtime/qwencode-shell.sh /usr/local/bin/agenthub-qwencode-shell
COPY deploy/runtime/qwencode-run.sh /usr/local/bin/agenthub-qwencode-run
COPY deploy/runtime/qwencode-toolchain.sh /etc/profile.d/agenthub-toolchain.sh
RUN chmod 0755 /usr/local/bin/agenthub-report-config /usr/local/bin/agenthub-qwencode-configure \
      /usr/local/bin/agenthub-qwencode-shell /usr/local/bin/agenthub-qwencode-run \
 && chmod 0644 /etc/profile.d/agenthub-toolchain.sh

USER 10000:10000
# The toolchain leads PATH so `python` and `pip` mean the agent's environment
# rather than the system interpreter, and so does the agent's own npm prefix.
ENV PATH=/home/agent/.venv/bin:/opt/agenthub/venv/bin:/home/agent/.npm-global/bin:$PATH \
    HOME=/home/agent \
    AGENTHUB_RUNTIME_TYPE=qwencode \
    AGENTHUB_WORKSPACE=/workspace \
    QWEN_CODE_HOME=/home/agent/.qwen \
    npm_config_prefix=/home/agent/.npm-global \
    npm_config_cache=/home/agent/.npm \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_CACHE_DIR=/home/agent/.cache/pip \
    PYTHONUNBUFFERED=1
WORKDIR /workspace
EXPOSE 7681
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/ttyd", "--port", "7681", "--interface", "127.0.0.1", "--writable", "/usr/local/bin/agenthub-qwencode-shell"]
