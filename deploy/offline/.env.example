# Image tag printed in the release notes and manifest (including the leading v).
AGENTHUB_VERSION=v0.234.0

# Required external PostgreSQL 17 connection. PostgreSQL is not included in the
# AgentHub image bundle. Configure TLS, authentication, backups and monitoring
# on the separately operated database before starting AgentHub.
AGENTHUB_POSTGRES_DSN=postgres://agenthub:replace-me@database.example.com:5432/agenthub?sslmode=require

AGENTHUB_BOOTSTRAP_ADMIN=admin
AGENTHUB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
AGENTHUB_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
AGENTHUB_HTTP_PORT=8080
