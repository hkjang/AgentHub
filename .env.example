# The bundled development PostgreSQL uses this local-only credential. For
# production, point this DSN at the separately managed offline PostgreSQL.
AGENTHUB_POSTGRES_DSN=postgres://agenthub:agenthub-local-database-password@postgres:5432/agenthub?sslmode=disable
AGENTHUB_BOOTSTRAP_ADMIN=admin
AGENTHUB_BOOTSTRAP_ADMIN_PASSWORD=change-this-immediately
# Generate with: openssl rand -base64 32
AGENTHUB_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
