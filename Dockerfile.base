# syntax=docker/dockerfile:1.7
# One offline runtime image carries every supported adapter (OpenCode, Hermes,
# QwenPaw). Pin these build args to approved versions for reproducible releases.
ARG HERMES_VERSION=v2026.7.1
FROM golang:1.25-bookworm AS proxy-build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/runtime-proxy ./cmd/runtime-proxy
# The whole internal tree, not the packages the proxy imports today. The gateway
# deliberately shares the control plane's own code — the tool-pattern matcher and
# the content detectors — so that both ends decide the same way, and enumerating
# those imports here is a trap: it compiles until somebody adds one, and then it
# fails in a release build rather than in CI, which is exactly how it failed once.
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/agenthub-runtime-proxy ./cmd/runtime-proxy

FROM nousresearch/hermes-agent:${HERMES_VERSION}
ARG OPENCODE_VERSION=1.18.18
# Node tooling an agent writing TypeScript reaches for before it can run
# anything. Global installs, because the workspace is the user's, not ours.
ARG NODE_TOOLCHAIN="typescript tsx prettier eslint pnpm"
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends nodejs npm git ca-certificates curl openssh-client tini \
      python3 python3-dev python3-venv build-essential pkg-config \
      jq ripgrep unzip zip less make procps tree sqlite3 \
 && npm install --global "opencode-ai@${OPENCODE_VERSION}" ${NODE_TOOLCHAIN} \
 && npm cache clean --force \
 && rm -rf /var/lib/apt/lists/* \
 && uv venv /opt/qwenpaw/.venv \
 && uv pip install --python /opt/qwenpaw/.venv/bin/python qwenpaw agentscope \
 && mkdir -p /workspace /home/agent/.config/opencode /home/agent/.hermes /home/agent/.qwenpaw /tmp \
 && chown -R 10000:10000 /workspace /home/agent /opt/qwenpaw

# The agent toolchain: `python`, `pip` and the libraries a coding agent reaches
# for first. It is a virtualenv of its own rather than the system interpreter,
# so an agent installing a package cannot break the adapters that share this
# image, and Debian's externally-managed marker never gets in the way. It is
# owned by the runtime user, so `pip install` works in a session whose security
# profile leaves the root filesystem writable; with a read-only root filesystem
# an agent creates its own environment under $HOME or /workspace instead, both
# of which are persistent volumes.
ARG AGENT_TOOLCHAIN="ruff black isort mypy pytest pytest-cov pytest-asyncio ipython ipykernel rich typer httpx requests pyyaml python-dotenv jinja2 tqdm pydantic tabulate numpy pandas matplotlib openpyxl beautifulsoup4 lxml openai anthropic mcp"
RUN uv venv --seed --python /usr/bin/python3 /opt/agenthub/venv \
 && uv pip install --python /opt/agenthub/venv/bin/python ${AGENT_TOOLCHAIN} \
 && chown -R 10000:10000 /opt/agenthub

# Miniforge rather than Anaconda's distribution: it is conda and mamba against
# conda-forge only, so an offline site swaps a channel instead of negotiating a
# licence. 'latest' resolves at build time; pin it for a reproducible release.
#
# Environments and package caches are pointed at the agent's home volume, so an
# environment an agent creates survives the Pod that created it.
ARG MINIFORGE_VERSION=latest
RUN set -eu; \
    arch="$(uname -m)"; \
    if [ "${MINIFORGE_VERSION}" = "latest" ]; then \
      url="https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-${arch}.sh"; \
    else \
      url="https://github.com/conda-forge/miniforge/releases/download/${MINIFORGE_VERSION}/Miniforge3-Linux-${arch}.sh"; \
    fi; \
    curl -fsSL "${url}" -o /tmp/miniforge.sh; \
    bash /tmp/miniforge.sh -b -p /opt/conda; \
    rm -f /tmp/miniforge.sh; \
    /opt/conda/bin/conda clean -afy; \
    printf 'envs_dirs:\n  - /home/agent/.conda/envs\npkgs_dirs:\n  - /home/agent/.conda/pkgs\nchannels:\n  - conda-forge\nchannel_priority: strict\n' > /opt/conda/.condarc; \
    chown -R 10000:10000 /opt/conda

COPY deploy/runtime/entrypoint.sh /usr/local/bin/agenthub-runtime
COPY deploy/runtime/qwenpaw-configure.sh /usr/local/bin/agenthub-qwenpaw-configure
COPY deploy/runtime/agenthub-toolchain.sh /etc/profile.d/agenthub-toolchain.sh
COPY --from=proxy-build /out/agenthub-runtime-proxy /usr/local/bin/agenthub-runtime-proxy
RUN chmod 0755 /usr/local/bin/agenthub-runtime /usr/local/bin/agenthub-qwenpaw-configure /usr/local/bin/agenthub-runtime-proxy \
 && chmod 0644 /etc/profile.d/agenthub-toolchain.sh
USER 10000:10000
WORKDIR /workspace
# The toolchain leads PATH so `python` and `pip` mean the agent's environment
# rather than an adapter's; every adapter starts from an absolute path anyway.
ENV PATH=/opt/agenthub/venv/bin:/opt/conda/bin:$PATH \
    HOME=/home/agent \
    HERMES_HOME=/home/agent/.hermes \
    QWENPAW_HOME=/home/agent/.qwenpaw \
    OPENCODE_CONFIG_DIR=/home/agent/.config/opencode \
    AGENTHUB_RUNTIME_TYPE=opencode \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_CACHE_DIR=/home/agent/.cache/pip \
    UV_CACHE_DIR=/home/agent/.cache/uv \
    npm_config_cache=/home/agent/.npm
EXPOSE 4096 8642 9119
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/agenthub-runtime"]
