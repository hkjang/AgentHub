# syntax=docker/dockerfile:1.7
#
# The BrowserCode runtime image.
#
# BrowserCode is a coding agent that drives a real Chrome through the DevTools
# Protocol: instead of a fixed set of browser actions, it writes JavaScript and
# runs it against the page. It is here because it speaks the Agent Client
# Protocol natively — `bcode acp` — so the platform's ACP backend drives it with
# no execution code of its own, and because a browser is the one thing none of
# the other runtimes can reach.
#
# Two programs run in this container. Chromium listens for DevTools on loopback,
# started by the runtime's own command; `ttyd` puts the agent's terminal in a
# browser. The agent attaches to the first through the instructions this image
# ships, and a person reaches the second only through the token-checking proxy.
#
# Chromium runs with its own sandbox disabled, because it cannot start inside an
# unprivileged container with it on — that sandbox needs user namespaces the
# restricted security profile denies. The container is the boundary instead: an
# unprivileged user, no cluster credentials, and whatever network policy the
# platform applied. That trade is stated in the runtime's description too, since
# it is the one thing an operator should know before pointing this at the web.
FROM debian:bookworm-slim

# Pinned with their checksums: these are binaries downloaded at build time, and
# unpinned ones would make the image unreproducible in exactly the way an offline
# release must not be.
ARG BROWSERCODE_VERSION=0.1.20
ARG BROWSERCODE_SHA256_X86_64=af259261fb0562fc23c9996c2d7a627ca0d657c91ca1721427947d3427734b68
ARG BROWSERCODE_SHA256_AARCH64=
ARG TTYD_VERSION=1.7.7
ARG TTYD_SHA256_X86_64=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55
ARG TTYD_SHA256_AARCH64=

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      chromium ca-certificates curl git tini jq ripgrep less procps bash \
      fonts-liberation fonts-noto-cjk python3 python3-venv \
 && arch="$(uname -m)"; \
    case "${arch}" in \
      x86_64) bcode_asset="bcode-linux-x64.tar.gz"; bcode_sum="${BROWSERCODE_SHA256_X86_64}"; \
              ttyd_asset="ttyd.x86_64"; ttyd_sum="${TTYD_SHA256_X86_64}" ;; \
      aarch64) bcode_asset="bcode-linux-arm64.tar.gz"; bcode_sum="${BROWSERCODE_SHA256_AARCH64}"; \
              ttyd_asset="ttyd.aarch64"; ttyd_sum="${TTYD_SHA256_AARCH64}" ;; \
      *) echo "unsupported architecture ${arch}" >&2; exit 1 ;; \
    esac; \
    if [ -z "${bcode_sum}" ] || [ -z "${ttyd_sum}" ]; then \
      echo "no checksum pinned for ${arch}; refusing to ship an unverified binary" >&2; exit 1; fi; \
    curl -fsSL -o /tmp/bcode.tar.gz \
      "https://github.com/browser-use/browsercode/releases/download/v${BROWSERCODE_VERSION}/${bcode_asset}"; \
    echo "${bcode_sum}  /tmp/bcode.tar.gz" | sha256sum -c -; \
    tar xzf /tmp/bcode.tar.gz -C /usr/local/bin bcode; \
    rm -f /tmp/bcode.tar.gz; \
    curl -fsSL -o /usr/local/bin/ttyd "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/${ttyd_asset}"; \
    echo "${ttyd_sum}  /usr/local/bin/ttyd" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/bcode /usr/local/bin/ttyd \
 && rm -rf /var/lib/apt/lists/*

# The toolchain a coding agent reaches for, on the home volume so `pip install`
# works without root under a read-only root filesystem. Deliberately short: what
# is missing is one install away.
ARG AGENT_TOOLCHAIN="pip setuptools wheel ruff pytest rich httpx requests pyyaml python-dotenv tabulate"
RUN python3 -m venv /opt/agenthub/venv \
 && /opt/agenthub/venv/bin/pip install --no-cache-dir --upgrade ${AGENT_TOOLCHAIN} \
 && useradd --uid 10000 --gid 0 --home-dir /home/agent --create-home agent \
 && mkdir -p /workspace /home/agent/.config/bcode /home/agent/.chrome-profile /home/agent/.cache \
 && chown -R 10000:0 /workspace /home/agent /opt/agenthub \
 && chmod -R g+rwX /home/agent /workspace

COPY deploy/runtime/agenthub-report-config.sh /usr/local/bin/agenthub-report-config
COPY deploy/runtime/browsercode-configure.sh /usr/local/bin/agenthub-browsercode-configure
COPY deploy/runtime/browsercode-shell.sh /usr/local/bin/agenthub-browsercode-shell
COPY deploy/runtime/browsercode-run.sh /usr/local/bin/agenthub-browsercode-run
COPY deploy/runtime/browsercode-start.sh /usr/local/bin/agenthub-browsercode-start
COPY deploy/runtime/browsercode-toolchain.sh /etc/profile.d/agenthub-toolchain.sh
# How to reach the browser this image runs. It is referenced from the generated
# configuration rather than copied into it, so it is one file to correct if the
# agent's browser API changes.
COPY deploy/runtime/browsercode-browser.md /opt/agenthub/browsercode-browser.md
RUN chmod 0755 /usr/local/bin/agenthub-report-config /usr/local/bin/agenthub-browsercode-configure \
      /usr/local/bin/agenthub-browsercode-shell /usr/local/bin/agenthub-browsercode-run \
      /usr/local/bin/agenthub-browsercode-start \
 && chmod 0644 /etc/profile.d/agenthub-toolchain.sh /opt/agenthub/browsercode-browser.md

USER 10000:0
ENV PATH=/home/agent/.venv/bin:/opt/agenthub/venv/bin:$PATH \
    HOME=/home/agent \
    AGENTHUB_RUNTIME_TYPE=browsercode \
    AGENTHUB_WORKSPACE=/workspace \
    AGENTHUB_BROWSER_PROFILE=/home/agent/.chrome-profile \
    BCODE_CONFIG_HOME=/home/agent/.config/bcode \
    DO_NOT_TRACK=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_CACHE_DIR=/home/agent/.cache/pip \
    PYTHONUNBUFFERED=1
WORKDIR /workspace
EXPOSE 7681
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/ttyd", "--port", "7681", "--interface", "127.0.0.1", "--writable", "/usr/local/bin/agenthub-browsercode-shell"]
